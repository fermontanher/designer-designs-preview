{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Designer Designs — shop preview",
		"description": "WooCommerce preview of the Designer Designs website. Test payments only.",
		"author": "fermontanher"
	},
	"landingPage": "/",
	"preferredVersions": { "php": "8.3", "wp": "latest" },
	"features": { "networking": true },
	"login": false,
	"steps": [
		{ "step": "installPlugin", "pluginData": { "resource": "wordpress.org/plugins", "slug": "woocommerce" }, "options": { "activate": true } },
		{ "step": "installTheme", "themeData": { "resource": "url", "url": "https://raw.githubusercontent.com/fermontanher/designer-designs-preview/main/designer-designs-theme.zip" }, "options": { "activate": true } },
		{ "step": "installPlugin", "pluginData": { "resource": "url", "url": "https://raw.githubusercontent.com/fermontanher/designer-designs-preview/main/dd-starter-plugin.zip" }, "options": { "activate": true } },
		{ "step": "runPHP", "code": "<?php require_once '/wordpress/wp-load.php'; wp_set_current_user( 1 ); dd_starter_seed(); delete_option( 'dd_starter_pending' ); update_option( 'woocommerce_coming_soon', 'no' );" }
	]
}
